#!/bin/sh /etc/rc.common
# omnidns: policy-aware DNS proxy with fake-IP routing

START=19
STOP=89
USE_PROCD=1
PROG=/usr/sbin/omnidns
CONF=omnidns

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -c /etc/config/$CONF
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stderr 1
	procd_set_param file /etc/config/$CONF
	procd_close_instance
}

# Upstream resolv.conf files and namesets are re-read on SIGHUP.
reload_service() {
	procd_send_signal omnidns '*' HUP
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
	# WAN (re)connects rewrite /tmp/resolv.conf.d/resolv.conf.auto
	procd_add_raw_trigger "interface.*.up" 2000 /etc/init.d/omnidns reload
}
