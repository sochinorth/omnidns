# omnidns -- see /usr/share/doc/omnidns or the project README.
#
# omnidns answers LAN clients on port 53 itself; move dnsmasq's DNS to a
# loopback port first, e.g.:
#   uci set dhcp.@dnsmasq[0].port='5335'
#   uci add_list dhcp.@dnsmasq[0].server='...'   # or keep its resolv.conf.auto
#   uci commit dhcp; /etc/init.d/dnsmasq restart
# and keep DHCP advertising the router as DNS server (default).

config omnidns 'main'
	option port '53'
	list listen_addr '192.168.1.1'
	option fwmask '0xff000000'
	option fakeip_v4 '198.18.0.0/15'
	# option fakeip_v6 'fd00:198:18::/64'
	option block_mode 'nodata'

# Local names (*.lan, reverse lookups for the LAN) go to dnsmasq.
config rule 'local'
	option action 'forward'
	option upstream '/etc/omnidns.d/dnsmasq.conf'
	list nameset '/etc/omnidns.d/local.txt'

config rule 'adblock'
	option action 'block'
	list nameset '/tmp/omnidns.d/adlist/*'

# config rule 'fakeip_warp'
#	option action 'fakeip'
#	option upstream '/etc/omnidns.d/dns_1111.conf'
#	option fwmark '0x01'
#	list nameset '/etc/omnidns.d/warp/*.txt'

# The last rule has no nameset and matches everything.
config rule 'catchall'
	option action 'forward'
	option upstream '/tmp/resolv.conf.d/resolv.conf.auto'
